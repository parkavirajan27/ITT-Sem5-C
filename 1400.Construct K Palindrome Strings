#include <stdio.h>
#include <string.h>
#include <stdbool.h>
bool canConstruct(char* s, int k) {
    int len = strlen(s);
    if (k > len) {
        return false;
    }
    int char_counts[26] = {0};
    for (int i = 0; i < len; i++) {
        char_counts[s[i] - 'a']++;
    }
    int odd_count = 0;
    for (int i = 0; i < 26; i++) {
        if (char_counts[i] % 2 != 0) {
            odd_count++;
        }
    }
    return k >= odd_count;
}
