#include <stdio.h>
#include <stdlib.h>
#include <string.h>
typedef struct {
    int x;
    int height;
    int id; 
    int is_end; 
} Event;
typedef struct {
    int height;
    int right; 
} HeapNode;
int compareEvents(const void* a, const void* b) {
    Event* e1 = (Event*)a;
    Event* e2 = (Event*)b;    
    if (e1->x != e2->x) {
        return (e1->x < e2->x) ? -1 : 1;
    }
    int h1 = e1->is_end ? -e1->height : e1->height;
    int h2 = e2->is_end ? -e2->height : e2->height;
    return (h1 > h2) ? -1 : 1;
}
typedef struct {
    HeapNode* data;
    int size;
} MaxHeap;

void swap(HeapNode* a, HeapNode* b) {
    HeapNode temp = *a;
    *a = *b;
    *b = temp;
}

void push(MaxHeap* heap, int height, int right) {
    heap->data[heap->size].height = height;
    heap->data[heap->size].right = right;
    int i = heap->size;
    heap->size++;
    while (i > 0 && heap->data[i].height > heap->data[(i - 1) / 2].height) {
        swap(&heap->data[i], &heap->data[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

void pop(MaxHeap* heap) {
    if (heap->size <= 0) return;
    heap->size--;
    heap->data[0] = heap->data[heap->size];
    int i = 0;
    while (2 * i + 1 < heap->size) {
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        int largest = left;
        
        if (right < heap->size && heap->data[right].height > heap->data[left].height) {
            largest = right;
        }
        if (heap->data[i].height >= heap->data[largest].height) {
            break;
        }
        swap(&heap->data[i], &heap->data[largest]);
        i = largest;
    }
}
int** getSkyline(int** buildings, int buildingsSize, int* buildingsColSize, int* returnSize, int** returnColumnSizes) {
    if (buildingsSize == 0) {
        *returnSize = 0;
        return NULL;
    }

    int numEvents = buildingsSize * 2;
    Event* events = (Event*)malloc(numEvents * sizeof(Event));
    int eventIdx = 0;
    for (int i = 0; i < buildingsSize; i++) {
        events[eventIdx++] = (Event){buildings[i][0], buildings[i][2], i, 0}; 
        events[eventIdx++] = (Event){buildings[i][1], buildings[i][2], i, 1}; 
    }
    qsort(events, numEvents, sizeof(Event), compareEvents);
    MaxHeap heap;
    heap.data = (HeapNode*)malloc(buildingsSize * sizeof(HeapNode));
    heap.size = 0;
    int maxResults = numEvents;
    int** result = (int**)malloc(maxResults * sizeof(int*));
    *returnColumnSizes = (int*)malloc(maxResults * sizeof(int));
    int resultCount = 0;
    
    int prevMaxHeight = 0;
    
    for (int i = 0; i < numEvents; i++) {
        Event e = events[i];
        
        if (!e.is_end) {
            push(&heap, e.height, buildings[e.id][1]);
        }
        while (heap.size > 0 && heap.data[0].right <= e.x) {
            pop(&heap);
        }
        int currentMaxHeight = (heap.size > 0) ? heap.data[0].height : 0;
        if (currentMaxHeight != prevMaxHeight) {
            result[resultCount] = (int*)malloc(2 * sizeof(int));
            result[resultCount][0] = e.x;
            result[resultCount][1] = currentMaxHeight;
            (*returnColumnSizes)[resultCount] = 2;
            resultCount++;
            prevMaxHeight = currentMaxHeight;
        }
    }
    free(events);
    free(heap.data);
    
    *returnSize = resultCount;
    return result;
}
