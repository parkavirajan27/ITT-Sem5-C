int removeElement(int* nums, int numsSize, int val) {
    // The write pointer tracks the position where the next valid element should go
    int k = 0; 
    
    // The read pointer (i) scans through every element in the array
    for (int i = 0; i < numsSize; i++) {
        // If the current element is NOT the value we want to remove
        if (nums[i] != val) {
            // Overwrite the element at index 'k' with the valid element
            nums[k] = nums[i];
            // Move the write pointer forward
            k++;
        }
    }
    
    // 'k' represents the count of elements that are not equal to 'val'
    return k;
}
