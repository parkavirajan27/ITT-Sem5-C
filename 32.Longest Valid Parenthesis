class Solution:
    def longestValidParentheses(self, s: str) -> int:
        left = right = max_length = 0
        
        # Pass 1: Scan from Left to Right
        for char in s:
            if char == '(':
                left += 1
            else:
                right += 1
                
            if left == right:
                max_length = max(max_length, 2 * right)
            elif right > left:
                # Reset counters if we have an invalid sequence (e.g., extra ')')
                left = right = 0
                
        # Reset counters for the reverse pass
        left = right = 0
        
        # Pass 2: Scan from Right to Left
        for char in reversed(s):
            if char == '(':
                left += 1
            else:
                right += 1
                
            if left == right:
                max_length = max(max_length, 2 * left)
            elif left > right:
                # Reset counters if we have an invalid sequence (e.g., extra '(')
                left = right = 0
                
        return max_length
