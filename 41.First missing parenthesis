from typing import List

class Solution:
    def firstMissingPositive(self, nums: List[int]) -> int:
        n = len(nums)
        
        # Step 1: Cycle sort - Place each number x at its correct index (x - 1)
        for i in range(n):
            # Keep swapping until nums[i] is out of range, or already at the right spot
            while 1 <= nums[i] <= n and nums[i] != nums[nums[i] - 1]:
                # Calculate correct target index for the current number
                correct_idx = nums[i] - 1
                # Swap the elements in-place
                nums[i], nums[correct_idx] = nums[correct_idx], nums[i]
        
        # Step 2: Scan the array to find the first index that doesn't match the value
        for i in range(n):
            if nums[i] != i + 1:
                return i + 1
        
        # Step 3: If all positions match perfectly, the missing number is n + 1
        return n + 1
