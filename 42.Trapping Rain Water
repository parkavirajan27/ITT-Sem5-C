from typing import List

class Solution:
    def trap(self, height: List[int]) -> int:
        if not height:
            return 0
            
        left, right = 0, len(height) - 1
        left_max, right_max = height[left], height[right]
        total_water = 0
        
        while left < right:
            # The amount of trapped water is bounded by the shorter wall
            if left_max < right_max:
                left += 1
                # Update the running left maximum wall height
                left_max = max(left_max, height[left])
                # Water trapped at current index is the wall height minus bar height
                total_water += left_max - height[left]
            else:
                right -= 1
                # Update the running right maximum wall height
                right_max = max(right_max, height[right])
                # Water trapped at current index is the wall height minus bar height
                total_water += right_max - height[right]
                
        return total_water
