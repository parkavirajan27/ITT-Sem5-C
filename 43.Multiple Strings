#include <stdio.h>
#include <stdlib.h>
#include <string.h>
char* multiply(char* num1, char* num2) {    
    if (strcmp(num1, "0") == 0 || strcmp(num2, "0") == 0) {
        char* zero_res = (char*)malloc(2 * sizeof(char));
        strcpy(zero_res, "0");
        return zero_res;
    }
    int len1 = strlen(num1);
    int len2 = strlen(num2);
    int max_len = len1 + len2;   
    int* pos = (int*)calloc(max_len, sizeof(int)); 
    for (int i = len1 - 1; i >= 0; i--) {
        for (int j = len2 - 1; j >= 0; j--) {
            int mul = (num1[i] - '0') * (num2[j] - '0');
            int p1 = i + j;
            int p2 = i + j + 1;
            int sum = mul + pos[p2];

            pos[p1] += sum / 10;  
            pos[p2] = sum % 10;   
        }
    }    
    char* result = (char*)malloc((max_len + 1) * sizeof(char));
    int res_idx = 0;
    int start_skipping = 1;
    for (int i = 0; i < max_len; i++) {      
        if (start_skipping && pos[i] == 0) {
            continue;
        }
        start_skipping = 0;
        result[res_idx++] = pos[i] + '0';
    }
    result[res_idx] = '\0';   
    free(pos);
    return result;
}
