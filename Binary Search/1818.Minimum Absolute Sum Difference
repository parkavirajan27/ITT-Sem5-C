#include <stdio.h>
#include <stdlib.h>
#include <math.h>
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int minAbsoluteSumDiff(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    long long total_sum = 0;
    long long max_gain = 0;
    int MOD = 1000000007;
    int* sorted_nums1 = (int*)malloc(nums1Size * sizeof(int));
    for (int i = 0; i < nums1Size; i++) {
        sorted_nums1[i] = nums1[i];
    }
    qsort(sorted_nums1, nums1Size, sizeof(int), compare);

    for (int i = 0; i < nums1Size; i++) {
        long long current_diff = labs((long long)nums1[i] - nums2[i]);
        total_sum += current_diff;
        int low = 0, high = nums1Size - 1;
        int closest_val = sorted_nums1[0];
        long long min_diff = labs((long long)closest_val - nums2[i]);

        while (low <= high) {
            int mid = low + (high - low) / 2;
            long long diff = labs((long long)sorted_nums1[mid] - nums2[i]);

            if (diff < min_diff) {
                min_diff = diff;
            }

            if (sorted_nums1[mid] < nums2[i]) {
                low = mid + 1;
            } else if (sorted_nums1[mid] > nums2[i]) {
                high = mid - 1;
            } else {
                min_diff = 0;
                break;
            }
        }
        long long current_gain = current_diff - min_diff;
        if (current_gain > max_gain) {
            max_gain = current_gain;
        }
    }

    free(sorted_nums1);
    long long final_ans = (total_sum - max_gain) % MOD;
    return (int)final_ans;
}
