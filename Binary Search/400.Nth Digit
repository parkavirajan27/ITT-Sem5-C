#include <stdio.h>
#include <math.h>

int findNthDigit(int n) {
    long long len = 1;
    long long count = 9;
    long long start = 1;
    while (n > len * count) {
        n -= len * count;
        len++;
        count *= 10;
        start *= 10;
    }
    long long targetNum = start + (n - 1) / len;
    int digitIdx = (n - 1) % len;
    char buffer[32];
    sprintf(buffer, "%lld", targetNum);
    return buffer[digitIdx] - '0';
}
