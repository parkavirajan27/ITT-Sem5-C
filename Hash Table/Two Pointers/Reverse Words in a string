#include <string.h>
void reverse(char* s, int left, int right) {
    while (left < right) {
        char temp = s[left];
        s[left] = s[right];
        s[right] = temp;
        left++;
        right--;
    }
}
char* reverseWords(char* s) {
    int n = strlen(s);
    int i = 0, j = 0;
    while (j < n) {
        while (j < n && s[j] == ' ') j++;
        if (j < n && i > 0) {
            s[i++] = ' ';
        }
        while (j < n && s[j] != ' ') {
            s[i++] = s[j++];
        }
    }
    s[i] = '\0'; 
    int len = i; 
    reverse(s, 0, len - 1);
    int start = 0;
    for (int end = 0; end <= len; end++) {
        if (end == len || s[end] == ' ') {
            reverse(s, start, end - 1);
            start = end + 1; 
        }
    }
    return s;
}
