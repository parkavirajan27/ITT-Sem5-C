#include <stdlib.h>
#include <string.h>

#ifndef MIN
#define MIN(a,b) (((a)<(b))?(a):(b))
#endif

int minimumCoins(int* prices, int pricesSize) {
    int n = pricesSize;
    int* dp = (int*)calloc(n + 2, sizeof(int));
    int* deque = (int*)malloc((n + 2) * sizeof(int));
    int head = 0;
    int tail = 0;
    for (int i = n; i >= 1; i--) {
        if (2 * i >= n) {
            dp[i] = prices[i - 1];
        } else {
            while (head < tail && deque[head] > 2 * i + 1) {
                head++;
            }
            dp[i] = prices[i - 1] + dp[deque[head]];
        }
        while (head < tail && dp[deque[tail - 1]] >= dp[i]) {
            tail--;
        }
        deque[tail++] = i;
    }
    
    int result = dp[1];
    free(dp);
    free(deque);
    
    return result;
}
