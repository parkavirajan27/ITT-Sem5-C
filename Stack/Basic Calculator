#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>
int calculate(char* s) {
    int len = strlen(s);
    int* stack_ans = (int*)malloc(sizeof(int) * len);
    int* stack_sign = (int*)malloc(sizeof(int) * len);
    int top = 0;
    int ans = 0;
    int sign = 1;     
    for (int i = 0; i < len; i++) {
        char c = s[i];
        
        if (isdigit(c)) {
            long long num = 0;
            while (i < len && isdigit(s[i])) {
                num = num * 10 + (s[i] - '0');
                i++;
            }
            i--; 
            
            ans += sign * num;
        } 
        else if (c == '+') {
            sign = 1;
        } 
        else if (c == '-') {
            sign = -1;
        } 
        else if (c == '(') {
            stack_ans[top] = ans;
            stack_sign[top] = sign;
            top++;
            ans = 0;
            sign = 1;
        } 
        else if (c == ')') {
            top--;
            int prev_sign = stack_sign[top];
            int prev_ans = stack_ans[top];
            
            ans = prev_ans + (prev_sign * ans);
        }
    }
    free(stack_ans);
    free(stack_sign);
    return ans;
}
