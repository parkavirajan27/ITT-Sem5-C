#include <stdio.h>
#include <ctype.h>
#include <string.h>

int calculate(char* s) {
    if (s == NULL || strlen(s) == 0) return 0;

    long long currentNum = 0;
    long long lastNum = 0;
    long long totalResult = 0;
    char lastOp = '+'; 
    for (int i = 0; s[i] != '\0'; i++) {
        char c = s[i];
        if (isdigit(c)) {
            currentNum = currentNum * 10 + (c - '0');
        }
        if ((!isdigit(c) && c != ' ') || s[i + 1] == '\0') {
            switch (lastOp) {
                case '+':
                    totalResult += lastNum; 
                    lastNum = currentNum;   
                    break;
                case '-':
                    totalResult += lastNum;
                    lastNum = -currentNum;  
                    break;
                case '*':
                    lastNum = lastNum * currentNum; 
                    break;
                case '/':
                    lastNum = lastNum / currentNum; 
                    break;
            }
            lastOp = c;          
            currentNum = 0;      
        }
    }
    totalResult += lastNum;
    return (int)totalResult;
}
